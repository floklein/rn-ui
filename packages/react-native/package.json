{
  "name": "@ui-sdk/react-native",
  "version": "0.0.0",
  "private": true,
  "description": "UI SDK for React Native.",
  "keywords": [
    "react-native",
    "ui",
    "ui-sdk",
    "behaviors",
    "accessibility",
    "a11y",
    "headless",
    "unstyled",
    "components"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    "./avatar": "./src/avatar.tsx",
    "./button": "./src/button.tsx",
    "./checkbox": "./src/checkbox.tsx",
    "./collapsible": "./src/collapsible.tsx",
    "./field": "./src/field.tsx",
    "./input": "./src/input.tsx",
    "./meter": "./src/meter.tsx",
    "./pagination": "./src/pagination.tsx",
    "./password-input": "./src/password-input.tsx",
    "./primitive": "./src/primitive.ts",
    "./progress": "./src/progress.tsx",
    "./radio": "./src/radio.tsx",
    "./rating": "./src/rating.tsx",
    "./separator": "./src/separator.tsx",
    "./switch": "./src/switch.tsx",
    "./tabs": "./src/tabs.tsx",
    "./testing": "./src/testing.ts",
    "./textarea": "./src/textarea.tsx",
    "./toggle": "./src/toggle.tsx"
  },
  "sideEffects": [
    "./src/native-host.ts",
    "./dist/native-host.js"
  ],
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "exports": {
      "./avatar": {
        "types": "./dist/avatar.d.ts",
        "default": "./dist/avatar.js"
      },
      "./button": {
        "types": "./dist/button.d.ts",
        "default": "./dist/button.js"
      },
      "./checkbox": {
        "types": "./dist/checkbox.d.ts",
        "default": "./dist/checkbox.js"
      },
      "./collapsible": {
        "types": "./dist/collapsible.d.ts",
        "default": "./dist/collapsible.js"
      },
      "./field": {
        "types": "./dist/field.d.ts",
        "default": "./dist/field.js"
      },
      "./input": {
        "types": "./dist/input.d.ts",
        "default": "./dist/input.js"
      },
      "./meter": {
        "types": "./dist/meter.d.ts",
        "default": "./dist/meter.js"
      },
      "./pagination": {
        "types": "./dist/pagination.d.ts",
        "default": "./dist/pagination.js"
      },
      "./password-input": {
        "types": "./dist/password-input.d.ts",
        "default": "./dist/password-input.js"
      },
      "./primitive": {
        "types": "./dist/primitive.d.ts",
        "default": "./dist/primitive.js"
      },
      "./progress": {
        "types": "./dist/progress.d.ts",
        "default": "./dist/progress.js"
      },
      "./radio": {
        "types": "./dist/radio.d.ts",
        "default": "./dist/radio.js"
      },
      "./rating": {
        "types": "./dist/rating.d.ts",
        "default": "./dist/rating.js"
      },
      "./separator": {
        "types": "./dist/separator.d.ts",
        "default": "./dist/separator.js"
      },
      "./switch": {
        "types": "./dist/switch.d.ts",
        "default": "./dist/switch.js"
      },
      "./tabs": {
        "types": "./dist/tabs.d.ts",
        "default": "./dist/tabs.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./textarea": {
        "types": "./dist/textarea.d.ts",
        "default": "./dist/textarea.js"
      },
      "./toggle": {
        "types": "./dist/toggle.d.ts",
        "default": "./dist/toggle.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build/build-package.mjs",
    "prepack": "cp ../../LICENSE LICENSE",
    "typecheck": "node ../../scripts/tsgo.mjs --noEmit && node ../../scripts/tsgo.mjs --noEmit -p tsconfig.test.json",
    "test": "jest"
  },
  "peerDependencies": {
    "@ui-sdk/core": "workspace:^",
    "react": ">=19",
    "react-native": ">=0.88"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "@ui-sdk/core": "workspace:*",
    "jest": "^29.7.0",
    "react": "catalog:",
    "react-native": "0.88.1",
    "test-renderer": "^1.0.0"
  }
}
